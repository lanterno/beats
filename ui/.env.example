# Beats UI Configuration

# API URL (used by React frontend)
# Note: Vite requires VITE_ prefix for client-side env vars
VITE_API_URL=http://localhost:7999

# Cloudflare Web Analytics site token, read by the signed-out landing page only
# (shared/lib/landingAnalytics.ts). Empty means no beacon. lifepete.com's deploy
# sets it from the CF_WEB_ANALYTICS_TOKEN repository variable; the self-hosted
# Docker build passes none.
VITE_CF_WEB_ANALYTICS_TOKEN=
