# Beats UI Configuration

# API URL (used by React frontend)
# Note: Vite requires VITE_ prefix for client-side env vars
VITE_API_URL=http://localhost:7999

# Plausible analytics domain. Leave empty to disable — index.html no-ops when
# this is unset, and defining it empty keeps Vite from warning about an
# unsubstituted %VITE_PLAUSIBLE_DOMAIN% placeholder on every request.
VITE_PLAUSIBLE_DOMAIN=
