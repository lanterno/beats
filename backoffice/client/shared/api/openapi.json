      "QueueRow": {
        "description": "One row behind an Attention count: what it is, which id, since when,\nand when it is due. Ids and dates only. Nothing stores that a row was\nhandled; it leaves when its condition clears.\n\nSuperseded approvals and absence requests are one row per organisation\n(`count` of them, `since` the oldest), with no member named.",
        "properties": {
          "count": {
            "default": 1,
            "title": "Count",
            "type": "integer"
          },
          "due": {
            "format": "date-time",
            "title": "Due",
            "type": "string"
          },
          "kind": {
            "enum": [
              "organisation_without_owner",
              "organisation_all_owners_suspended",
              "job_failed",
              "job_queued",
              "approvals_superseded",
              "absence_requests_pending",
              "account_near_coach_cap",
              "control_paused"
            ],
            "title": "Kind",
            "type": "string"
          },
          "since": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Since"
          },
          "subject_id": {
            "title": "Subject Id",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "subject_id",
          "since",
          "due"
        ],
        "title": "QueueRow",
        "type": "object"
      },
