    "/api/operator/commands/{name}/preview": {
      "post": {
        "description": "What the command would do, before it does any of it.\n\nA POST because it carries the same arguments the act does, an account's\nid among them, and because the operator's credential is IAP's cookie:\nevery state-changing shape is a POST with an Origin the app checks, and\nthis one is shaped like the act it previews. It writes nothing, queues\nnothing, and takes the same role \u2014 a `viewer` gets the same 403 here as\non the act, because a preview it could read would be a way to probe\nwhether an id exists.",
        "operationId": "preview_api_operator_commands__name__preview_post",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
