  "info": {
    "description": "The control plane: operational metadata, never user content",
    "title": "Beats operator API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/operator/abuse": {
      "get": {
        "description": "Outliers rather than guessed thresholds: who is far from the median on\nthe axes a hostile account shows on.",
        "operationId": "abuse_api_operator_abuse_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AbuseReport"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Abuse",
        "tags": [
          "operator"
        ]
      }
    },
    "/api/operator/accounts/lookup": {
      "post": {
        "description": "Every account an address matches, case-insensitively \u2014 `Ana@` and\n`ana@` can be two accounts, and a mail from either spelling must find\nboth. A read, despite the POST: the body keeps the address out of the\nrequest log.",
        "operationId": "lookup_accounts_api_operator_accounts_lookup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountLookupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AccountMatch"
                  },
                  "title": "Response Lookup Accounts Api Operator Accounts Lookup Post",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Lookup Accounts",
        "tags": [
          "operator"
        ]
      }
    },
    "/api/operator/accounts/{user_id}": {
      "get": {
        "description": "One account: state, counts and a storage estimate \u2014 how big, never\nwhat. Which identities it holds per provider is a fact the account\nstores; which door a sign-in used is deliberately not kept, and must not\ngrow out of this page.",
        "operationId": "account_api_operator_accounts__user_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "title": "User Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Account",
        "tags": [
          "operator"
        ]
      }
    },
    "/api/operator/attention": {
      "get": {
        "description": "The landing page's counts: the reason to open the control plane.",
        "operationId": "attention_api_operator_attention_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttentionCounts"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Attention",
        "tags": [
          "operator"
        ]
      }
    },
    "/api/operator/audit": {
      "get": {
        "description": "The operator's own audit \u2014 empty until step 3's commands write it.",
        "operationId": "audit_log_api_operator_audit_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 200,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Audit Log Api Operator Audit Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Audit Log",
        "tags": [
          "operator"
        ]
      }
    },
    "/api/operator/capacity": {
      "get": {
        "description": "What the platform will cost: documents and storage per collection, and\nthe coach's cost by day and model with the cache-hit ratio's inputs.\nLatency and error rates are Cloud Monitoring's \u2014 link, don't rebuild.",
