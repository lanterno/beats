# The operator deployment's settings (roadmaps/backoffice.md, step 2) — copy
# to .env.operator for local development. It never holds JWT_SECRET: the
# operator app has no field for it.

OPERATOR_DB_DSN=mongodb://localhost:27017
OPERATOR_DB_NAME=beats

# Locally, the IAP stand-in: every request is treated as this sub. In a
# deployment, set OPERATOR_IAP_AUDIENCE instead
# (/projects/PROJECT_NUMBER/locations/REGION/services/beats-operator) —
# exactly one of the two, or the settings refuse to load.
BACKOFFICE_DEV_OPERATOR=dev-operator

# Who may act, by IAP's sub. The email is shown, never matched.
OPERATOR_ALLOWLIST='[{"sub": "dev-operator", "email": "you@example.com", "role": "operator"}]'

# The back office's origin: the Vite dev server locally, the run.app URL in
# production. Writes from any other origin are refused.
OPERATOR_ORIGIN=http://localhost:8081

# Mirrors the API's COACH_MONTHLY_BUDGET_USD, for the landing page's
# "near the cap" count and the account page's bar.
COACH_MONTHLY_BUDGET_USD=10.0
