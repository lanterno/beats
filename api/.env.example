# Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
DB_DSN=mongodb://mango:bango@localhost:27017/?authSource=admin
DB_NAME=beats

# WebAuthn Configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Beats
WEBAUTHN_ORIGIN=http://localhost:8080

# JWT Secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET=local-dev-secret-change-in-production

# AI Coach (Anthropic API)
ANTHROPIC_API_KEY=sk-ant-...

# Application Port (when running locally)
PORT=7999

# ---------------------------------------------------------------------------
# home.space SSO (optional second front door)
#
# Off by default. Beats keeps its own email + passkey login either way; this
# adds the option of signing in with a home.space identity instead. The home
# deployment sets these in compose.home.yml, not here.
# ---------------------------------------------------------------------------

# BEATS_SSO_ENABLED=true

# The issuer DID that must appear in the token's `iss` claim.
# BEATS_SSO_ISSUER=did:web:auth.home.space

# Where THIS PROCESS reaches the issuer. Loopback on the host; inside a
# container use host.docker.internal (see compose.home.yml).
# BEATS_SSO_AUTH_BASE_URL=http://127.0.0.1:6007

# Where the BROWSER is sent to get a session. Leave unset to derive it from
# each request's own Host, which is what makes one build serve
# beats.home.space, beats.<lan-ip>.nip.io and the WAN name alike.
# BEATS_SSO_LOGIN_URL=

# Roles allowed to CREATE a new beats account on first SSO sign-in. Any role
# may still link to an account that already exists. Empty means no gate.
# BEATS_SSO_PROVISION_ROLES=owner,admin
