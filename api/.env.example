# Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
DB_DSN=mongodb://mango:bango@localhost:27017/?authSource=admin
DB_NAME=beats

# WebAuthn Configuration
WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME overrides the passkey-prompt name; it defaults to beats/brand.py.
WEBAUTHN_ORIGIN=http://localhost:8080

# JWT Secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET=local-dev-secret-change-in-production

# AI Coach (Anthropic API)
ANTHROPIC_API_KEY=sk-ant-...

# Application Port (when running locally)
PORT=7999

# ---------------------------------------------------------------------------
# Single sign-on through OpenID Connect (optional second front door)
#
# Off unless OIDC_PROVIDERS names at least one provider. Beats keeps its own
# email + passkey login either way; each provider adds a "Continue with
# <name>" button. Register OIDC_REDIRECT_URI (exactly) with each provider.
# ---------------------------------------------------------------------------

# The web app's /auth/callback on this deployment. https, except localhost.
# OIDC_REDIRECT_URI=http://localhost:8080/auth/callback

# A JSON list. Per provider:
#   id            lowercase letters, digits, hyphens; names it in URLs
#   name          on the button
#   issuer        exactly as its /.well-known/openid-configuration states it
#   client_id     from the provider
#   client_secret from the provider; "" for a public client (PKCE either way)
#   scopes        default "openid email profile"
#   allow_signup  true lets someone without an account here get one through
#                 this provider; default false (they link from Settings instead)
# OIDC_PROVIDERS='[{"id": "google", "name": "Google", "issuer": "https://accounts.google.com", "client_id": "...", "client_secret": "..."}]'
