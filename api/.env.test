# .env.test
DB_DSN=mongodb://localhost:27017
DB_NAME=beats_test
# 48-byte fixed test secret. Production deploys MUST use
# `openssl rand -base64 48` — do not reuse this value.
JWT_SECRET=test-secret-fixed-for-the-pytest-suite-only-not-for-prod-deploy
# Cloud Run's front end connects from link-local; the tests stand in for it
# with TestClient(client=("169.254.169.126", ...)). See settings.py.
FORWARDED_ALLOW_IPS=169.254.0.0/16
